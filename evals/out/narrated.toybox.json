   "text": "This is a zebra crossing."
  },
  {
   "start": 2.38,
   "end": 4.541,
   "text": "White stripes mark it on the road."
  },
  {
   "start": 4.541,
   "end": 6.715,
   "text": "A person steps onto the crossing."
  },
  {
   "start": 6.715,
   "end": 10.093,
   "text": "In the United Kingdom, a driver must then give way."
  },
  {
   "start": 10.093,
   "end": 15.647,
   "text": "The car stops, and the person walks across."
  },
  {
   "start": 15.647,
   "end": 18.093,
   "text": "The car goes on when the road is clear."
  },
  {
   "start": 18.093,
   "end": 23.917,
   "text": "The first zebra crossing opened in Slough on 31 October 1951."
  }
